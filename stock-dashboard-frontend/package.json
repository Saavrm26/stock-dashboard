{
  "name": "stock-dashboard-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "proto:gen": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./model/generated --ts_proto_opt=esModuleInterop=true,outputServices=generic-definitions,useExactTypes=false --proto_path=../common/proto ../common/proto/v1/*.proto",
    "dev": "next dev",
    "build": "yarn proto:gen && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.44.9",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "ts-proto": "^2",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.18.0"
}
